# CampusMate AI (AIDTM) - configuration template.
# Copy to .env (never commit .env) and edit.   Windows CMD:  copy .env.example .env
# Every variable below is read by app/config.py; a test fails if this file and the code ever disagree.

# ---------------------------------------------------------------- environment
# development | production | test.  Production refuses to start unless SECRET_KEY, secure cookies etc. are set (see README).
APP_ENV=development
# FLASK_ENV=development            (accepted as an alias of APP_ENV)
# Random string of 32+ characters used to HMAC session tokens. REQUIRED in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
# SQLite by default. Any SQLAlchemy URL works, e.g. PostgreSQL: postgresql+psycopg://user:password@host/dbname
DATABASE_URL=sqlite:///instance/campus_desk.db
LOG_LEVEL=INFO

# ---------------------------------------------------------------- LLM provider: Groq Cloud (OpenAI-compatible API, native function calling)
# groq = Groq Cloud (console.groq.com).   mock = OFFLINE TEST DOUBLE (a rule-based planner, not a language model; tests/demos only, refused in production).
# The app uses ONLY the provider named here and never falls back to another. Any other value is rejected.
LLM_PROVIDER=groq
# Create a key at https://console.groq.com/keys . Copy the whole key (shown once), no quotes or spaces. It is read from .env only, never logged or stored.
GROQ_API_KEY=your-groq-api-key
# Must be a model that supports tool (function) calling. No default on purpose, because Groq retires models: check https://console.groq.com/docs/models .
# openai/gpt-oss-20b is the model this project's Groq connection was independently verified with.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Sampling temperature. Use  none  to NOT send the parameter (some reasoning models reject it; the app also retries once without it automatically).
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- context selection
CONTEXT_TOKEN_BUDGET=6000
HISTORY_MAX_TURNS=8
MAX_MESSAGE_CHARS=2000
MEMORY_MAX_SELECTED=5

# ---------------------------------------------------------------- policy document (RAG)
POLICY_DOCUMENT_PATH=data/kb/AIDTM_Student_Handbook_KB_v3.md
POLICY_DOCUMENT_NAME=AIDTM Student Handbook KB
POLICY_DOCUMENT_VERSION=3.0
# Used for documents that are not in the structured handbook format (words per chunk / words of overlap)
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=2.0
# Abstain ("not covered") when this share of a question's weight is on words absent from the handbook
RETRIEVAL_OOV_RATIO=0.4
CHUNK_CONTEXT_CHARS=2500

# ---------------------------------------------------------------- sessions and authentication
SESSION_COOKIE_NAME=campus_session
# Must be true when served over HTTPS (required in production)
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_MINUTES=480
SESSION_IDLE_MINUTES=30
# scrypt (default) or e.g. pbkdf2:sha256:600000
PASSWORD_HASH_METHOD=scrypt
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=25
LOGIN_LOCKOUT_MINUTES=15
CHAT_RATE_LIMIT_PER_MIN=20
API_RATE_LIMIT_PER_MIN=300
# Login-page demo-account hint. Development only (refused in production).
SHOW_DEMO_ACCOUNTS=true
# Extra origins allowed to make state-changing requests (comma separated). Normally empty (same-origin only).
ALLOWED_ORIGINS=
ENABLE_API_DOCS=true

# ---------------------------------------------------------------- approvals, tickets, retention
APPROVAL_TTL_HOURS=72
TICKET_DUPLICATE_WINDOW_MINUTES=10
RETENTION_MESSAGES_DAYS=90
RETENTION_TRACES_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_LOGIN_ATTEMPTS_DAYS=30

# ---------------------------------------------------------------- demos
# Freezes "today" so fee/late-fee and exam-date answers are reproducible. Leave empty to use the real date.
DEMO_TODAY=2026-10-30
